{
  "name": "iot-discord-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Discord Bot for IOT-IMIN Olympia Training",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "deploy-command": "node src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/congminh1254/iot-discord-bot.git"
  },
  "author": "Minh Nguyen Cong",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/congminh1254/iot-discord-bot/issues"
  },
  "homepage": "https://github.com/congminh1254/iot-discord-bot#readme",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.3.0",
    "cors": "^2.8.6",
    "discord.js": "^14.28.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "moment": "^2.31.0",
    "node-schedule": "^2.1.2",
    "puppeteer": "^25.16.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-schedule": "^2.1.8",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
