# Copy to .env (never commit .env) and fill in real values.

# Discord
DISCORD_BOT_KEY=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Firebase: base64 of the web config JSON (must include apiKey and databaseURL)
FIREBASE_CONFIG=
# Firebase: base64 of the service account JSON
FIREBASE_SERVICE_ACCOUNT=
# IOT admin uid the bot signs in as when calling iot_socket
DEFAULT_ADMIN_UID=

# iot_socket
IOT_SOCKET_URL=https://iot-socket.chinhphucvn.com

# HTTP server
PORT=8080
# Shared secret required as "Authorization: Bearer <secret>" on POST /send_dm.
# When empty, /send_dm is disabled (returns 503).
WEBHOOK_SECRET=

# "true" to post Discord invites into IOT revise room chat
PUBLIC=false

# Google Cloud Translate uses GOOGLE_APPLICATION_CREDENTIALS when that file exists,
# otherwise it falls back to FIREBASE_SERVICE_ACCOUNT. Optional, e.g.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
